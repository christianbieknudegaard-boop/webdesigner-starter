// Bokfink-datamodellen. PostgreSQL både lokalt og i produksjon –
// se DEPLOY.md for oppsett (gratis database hos Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id           String    @id @default(cuid())
  name         String
  city         String
  email        String?   @unique
  passwordHash String?
  rating       Float     @default(0)
  salesCount   Int       @default(0)
  memberSince  DateTime  @default(now())
  listings     Listing[]
  sessions     Session[]
  purchases    Order[]        @relation("BuyerOrders")
  conversations Conversation[] @relation("BuyerConversations")
  messages     Message[]
  reports      Report[]
}

model Session {
  token     String   @id
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sellerId])
}

model Listing {
  id            String   @id @default(cuid())
  // "bok" eller "film"; author = regissør og isbn = EAN for film
  productType   String   @default("bok")
  // Kun for film: "dvd", "blu-ray" eller "4k"
  format        String   @default("")
  title         String
  author        String
  isbn          String   @default("")
  category      String
  condition     String
  price         Int
  originalPrice Int?
  description   String   @default("")
  coverColor    String
  imageUrl      String?
  sold          Boolean  @default(false)
  createdAt     DateTime @default(now())
  seller        Seller   @relation(fields: [sellerId], references: [id])
  sellerId      String
  order         Order?
  conversations Conversation[]
  reports       Report[]

  @@index([category, sold])
}

// Rapportering av annonser (svindel, feil informasjon osv.).
// Håndteres manuelt i databasen til et admin-panel er på plass.
model Report {
  id         String   @id @default(cuid())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  reporter   Seller   @relation(fields: [reporterId], references: [id])
  reporterId String
  reason     String
  comment    String   @default("")
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([listingId, reporterId])
}

// Samtale om en annonse mellom en interessent ("buyer") og selgeren.
model Conversation {
  id        String    @id @default(cuid())
  listing   Listing   @relation(fields: [listingId], references: [id])
  listingId String
  buyer     Seller    @relation("BuyerConversations", fields: [buyerId], references: [id])
  buyerId   String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([listingId, buyerId])
  @@index([buyerId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         Seller       @relation(fields: [senderId], references: [id])
  senderId       String
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Kjøp av en annonse. Betaling kobles på senere (Vipps/Stripe);
// statusflyten er kjopt -> sendt -> levert, eller kjopt -> kansellert
// (utløpt sendefrist eller ubesvart kanselleringsforespørsel).
model Order {
  id            String   @id @default(cuid())
  listing       Listing  @relation(fields: [listingId], references: [id])
  listingId     String   @unique
  buyer         Seller   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId       String
  status        String   @default("kjopt")
  // Selgers frist for å sende; kan utsettes én gang
  shipDeadline     DateTime?
  deadlineExtended Boolean   @default(false)
  // Kjøperens kanselleringsforespørsel; auto-kansellering uten svar
  cancelRequestedAt DateTime?
  itemPrice     Int
  shippingPrice Int      @default(45)
  // Leveringsadresse (fylles inn ved kjøp)
  shipName       String  @default("")
  shipStreet     String  @default("")
  shipPostalCode String  @default("")
  shipCity       String  @default("")
  // Kjøperens vurdering av selgeren etter levering (1–5)
  rating        Int?
  ratingComment String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([buyerId])
}
