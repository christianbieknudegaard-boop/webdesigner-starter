// Bokfink-datamodellen. PostgreSQL både lokalt og i produksjon –
// se DEPLOY.md for oppsett (gratis database hos Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id           String    @id @default(cuid())
  name         String
  city         String
  email        String?   @unique
  passwordHash String?
  rating       Float     @default(0)
  salesCount   Int       @default(0)
  memberSince  DateTime  @default(now())
  listings     Listing[]
  sessions     Session[]
  purchases    Order[]        @relation("BuyerOrders")
  conversations Conversation[] @relation("BuyerConversations")
  messages     Message[]
}

model Session {
  token     String   @id
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sellerId])
}

model Listing {
  id            String   @id @default(cuid())
  title         String
  author        String
  isbn          String   @default("")
  category      String
  condition     String
  price         Int
  originalPrice Int?
  description   String   @default("")
  coverColor    String
  imageUrl      String?
  sold          Boolean  @default(false)
  createdAt     DateTime @default(now())
  seller        Seller   @relation(fields: [sellerId], references: [id])
  sellerId      String
  order         Order?
  conversations Conversation[]

  @@index([category, sold])
}

// Samtale om en annonse mellom en interessent ("buyer") og selgeren.
model Conversation {
  id        String    @id @default(cuid())
  listing   Listing   @relation(fields: [listingId], references: [id])
  listingId String
  buyer     Seller    @relation("BuyerConversations", fields: [buyerId], references: [id])
  buyerId   String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([listingId, buyerId])
  @@index([buyerId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         Seller       @relation(fields: [senderId], references: [id])
  senderId       String
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Kjøp av en annonse. Betaling kobles på senere (Vipps/Stripe);
// statusflyten er kjopt -> sendt -> levert.
model Order {
  id            String   @id @default(cuid())
  listing       Listing  @relation(fields: [listingId], references: [id])
  listingId     String   @unique
  buyer         Seller   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId       String
  status        String   @default("kjopt")
  itemPrice     Int
  shippingPrice Int      @default(45)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([buyerId])
}
