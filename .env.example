# Kopier til .env og fyll inn.

# PostgreSQL-tilkobling.
# Lokalt (egen Postgres):   postgresql://bokfink:bokfink@localhost:5432/bokfink
# Neon (gratis, anbefalt):  kopier "Connection string" fra neon.tech-dashbordet
DATABASE_URL="postgresql://bokfink:bokfink@localhost:5432/bokfink"

# Kun i produksjon på Vercel: settes automatisk når du aktiverer Vercel Blob
# (bildelagring). Lokalt lagres bilder i uploads/-mappen uten denne.
# BLOB_READ_WRITE_TOKEN=""

# Valgfritt: gir tittelforslag for filmer i selg-flyten via TMDb.
# Gratis nøkkel: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=""
