{
  "expo": {
    "name": "Bokfink",
    "slug": "bokfink",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bokfink",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf7f2",
    "primaryColor": "#2f5d50",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Bokfink bruker kameraet til å skanne strekkoden på bøker du vil selge."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bokfink trenger tilgang til bildene dine for å legge ved bilde av boken du selger.",
          "cameraPermission": "Bokfink bruker kameraet til å ta bilde av boken du selger."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.bokfink.app"
    },
    "android": {
      "package": "no.bokfink.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2f5d50"
      }
    }
  }
}
